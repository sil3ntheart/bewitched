local charactersFolder = nil
local charactersFolderLastLookup = 0
local CHARACTERS_FOLDER_TTL = 5

local function refreshCharactersFolder()
    local now = clock()
    if charactersFolder and (now - charactersFolderLastLookup) < CHARACTERS_FOLDER_TTL then
        return charactersFolder
    end
    charactersFolderLastLookup = now
    local wsGame = findChild(workspace, "Game")
    charactersFolder = wsGame and findChild(wsGame, "Characters") or nil
    return charactersFolder
end

local function resolveCharacter(player)
    local c = player.Character
    if c and c.Parent then return c end
    local folder = refreshCharactersFolder()
    if folder then
        for _, m in ipairs(folder:GetChildren()) do
            if m.Name == player.Name then return m end
        end
    end
    return c
end

