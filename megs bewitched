local function readString(inst)
    if not inst then return nil end
    local ok, v = pcall(function() return inst.Value end)
    if ok and v and tostring(v) ~= "" then return tostring(v) end
    return nil
end

local function sanitizeSpecies(s)
    if not s then return nil end
    local cleaned = s:gsub("[^\32-\126]", "")
    cleaned = cleaned:gsub("^%s+", ""):gsub("%s+$", "")
    if cleaned == "" then return nil end
    return cleaned
end

local function getCachedChild(info, cacheKey, parent, name)
    local c = info[cacheKey]
    if c and c.Parent then return c end
    if not parent then return nil end
    local found = findChild(parent, name)
    info[cacheKey] = found
    return found
end

local function getCachedCharacterValues(info, char)
    if info.cv and info.cv.Parent == char then return info.cv end
    local cv = findChild(char, "CharacterValues")
    info.cv = cv
    return cv
end

local function readSpecieFromCharacter(info, char)
    local cv = getCachedCharacterValues(info, char)
    if not cv then return nil end
    local sp = getCachedChild(info, "specieNode", cv, "Specie")
    if not sp then return nil end
    local ok, v = pcall(function() return sp.Value end)
    if not ok or not v then return nil end
    return sanitizeSpecies(tostring(v))
end

local function readCharacterName(info, char)
    local head = getCachedChild(info, "headNode", char, "Head")
    if head then
        local infoGui = getCachedChild(info, "infoGuiNode", head, "Info")
        if infoGui then
            local cn = getCachedChild(info, "charNameLabel", infoGui, "CharacterName")
            if cn then
                local ok, txt = pcall(function() return cn.Text end)
                if ok and txt and txt ~= "" then return tostring(txt) end
            end
        end
    end
    local cv = getCachedCharacterValues(info, char)
    if cv then
        local cn = getCachedChild(info, "charNameValue", cv, "CharacterName")
        if cn then
            local ok, v = pcall(function() return cn.Value end)
            if ok and v and v ~= "" then return tostring(v) end
        end
    end
    return nil
end

local function readCharacterValuesBatch(info, char)
    local cv = getCachedCharacterValues(info, char)
    if not cv then return nil end

    local b = info.cvBatch
    if not b then
        b = {}
        info.cvBatch = b
    end
    b.specie          = nil
    b.characterName   = nil
    b.regent          = nil
    b.channeled       = nil
    b.connectiveMagic = nil
    b.sacrificeLink   = nil

    for _, c in ipairs(cv:GetChildren()) do
        local n = c.Name
        if n == "Specie" then
            b.specie = c
        elseif n == "CharacterName" then
            b.characterName = c
        elseif n == "Regent" then
            b.regent = c
        elseif n == "Channeled" then
            b.channeled = c
        elseif n == "ConnectiveMagic" then
            b.connectiveMagic = c
        elseif n == "SacrificeLink" then
            b.sacrificeLink = c
        end
    end

    return b
end

local function playerFromCharacter(model, map)
    if not model then return nil end
    local p = map[model]
    if p then return p end
    if not Players then return nil end
    for _, pl in ipairs(Players:GetPlayers()) do
        if resolveCharacter(pl) == model then return pl end
    end
    return nil
end

local function getLinkInfoFromBatch(b, map)
    if b.sacrificeLink then
        local ok, val = pcall(function() return b.sacrificeLink.Value end)
        if ok and val then
            local partner = playerFromCharacter(val, map)
            return partner and partner.Name or val.Name, "blade"
        end
    end

    if b.connectiveMagic then
        local ok, val = pcall(function() return b.connectiveMagic.Value end)
        if ok and val then
            local cn = nil
            if b.characterName then
                pcall(function() cn = b.characterName.Value end)
            end
            local isDahlia = cn and tostring(cn):lower():find("dahlia", 1, true)
            local partner = playerFromCharacter(val, map)
            local name = partner and partner.Name or val.Name
            if name then
                return name, isDahlia and "dahlia" or "linked"
            end
        end
    end

    return nil, nil
end

local function getTotemPosition()
    local gameFolder = findChild(workspace, "Game")
    if not gameFolder then return nil end

    local debris = findChild(gameFolder, "Debris")
    if debris then
        local totemModel = findChild(debris, "Totem")
        if totemModel then
            local mesh = findChild(totemModel, "Totem")
            if mesh and mesh.ClassName == "MeshPart" then
                return mesh.Position
            end
            if totemModel.PrimaryPart then
                return totemModel.PrimaryPart.Position
            end
            for _, part in ipairs(totemModel:GetDescendants()) do
                if (part.ClassName == "BasePart" or part.ClassName == "MeshPart" or part.ClassName == "Part") and part.Transparency < 1 then
                    local n = part.Name
                    if n ~= "Swirls" and n ~= "Swirls2" and n ~= "Boundary" then
                        return part.Position
                    end
                end
            end
        end
    end

    local rituals = findChild(gameFolder, "Rituals")
    if rituals then
        local totemModel = findChild(rituals, "Totem")
        if totemModel then
            local mesh = findChild(totemModel, "Totem")
            if mesh and mesh.ClassName == "MeshPart" then
                return mesh.Position
            end
        end
    end

    return nil
end

local function getBonesPosition()
    local gameFolder = findChild(workspace, "Game")
    if not gameFolder then return nil end
    local debris = findChild(gameFolder, "Debris")
    if not debris then return nil end
    local bones = findChild(debris, "Bones")
    if not bones then return nil end

    local main = findChild(bones, "Main")
    if main and main.ClassName == "Part" and main.Transparency < 1 then
        return main.Position
    end
    for _, part in ipairs(bones:GetChildren()) do
        if part.ClassName == "Part" and part.Transparency < 1 then
            return part.Position
        end
    end
    return nil
end

local function anyoneIsRegent()
    if not Players then return false, nil end
    for _, p in ipairs(Players:GetPlayers()) do
        local char = resolveCharacter(p)
        if char then
            local cv = findChild(char, "CharacterValues")
            if cv and findChild(cv, "Regent") then
                return true, p.Name
            end
        end
    end
    return false, nil
end
local tickCount = 0
local regentCurrentlyTaken = false
local regentInit = false

local function refreshPlayer(player, info, map)
    local char = resolveCharacter(player)

    if char ~= info.char then
        info.char = char
        info.hrp = nil
        info.hum = nil
        info.hp = nil
        info.regentText = nil
        info.linkText = nil
        info.linkKind = nil
        info.chText = nil
        info.charName = nil
        info.species = nil
        info.nameFallbackTick = nil
        info.cv = nil
        info.cvBatch = nil
        info.headNode = nil
        info.infoGuiNode = nil
        info.charNameLabel = nil
        info.charNameValue = nil
        info.specieNode = nil
    end
    if not char then return end

    if not info.hrp or not info.hrp.Parent then
        info.hrp = findChild(char, "HumanoidRootPart")
    end
    if not info.hum or not info.hum.Parent then
        info.hum = findChildOfClass(char, "Humanoid")
    end
    if info.hum then
        info.maxHp = math.floor(info.hum.MaxHealth)
    end

    info.species = readSpecieFromCharacter(info, char)

    local b = readCharacterValuesBatch(info, char)

    info.regentText = nil
    if flags.regent and b and b.regent then
        local rv = readString(b.regent)
        info.regentText = rv and ("Regent: " .. rv) or "Regent"
    end

    info.linkText, info.linkKind = nil, nil
    if flags.linked and b then
        local name, kind = getLinkInfoFromBatch(b, map)
        if name then
            info.linkKind = kind
            if kind == "blade" then
                info.linkText = "Blade Linked: " .. name
            elseif kind == "dahlia" then
                info.linkText = "Dahlia's Link: " .. name
            else
                info.linkText = "Linked: " .. name
            end
        end
    end

    info.chText = nil
    if flags.channeling and b and b.channeled then
        local t = readString(b.channeled)
        if t then info.chText = "Channeling: " .. t end
    end

    if flags.character then
        if b and b.characterName then
            local ok, v = pcall(function() return b.characterName.Value end)
            if ok and v and v ~= "" then
                info.charName = tostring(v)
            else
                info.charName = readCharacterName(info, char)
            end
        else
            info.charName = readCharacterName(info, char)
        end
    else
        info.charName = nil
    end
end

local function slowTick()
    tickCount = tickCount + 1
    local heavy = (tickCount % 2 == 0)

    local cam = workspace.CurrentCamera
    if cam then Camera = cam end

    if tickCount % 10 == 0 then
        syncPlayers()
        refreshCharactersFolder()
    end

    if flags.enabled then
        local camPos = Camera.CFrame.Position
        local cullDist = flags.maxDist * 1.1

        local map
        if heavy then
            map = {}
            if Players then
                for _, p in ipairs(Players:GetPlayers()) do
                    local c = resolveCharacter(p)
                    if c then map[c] = p end
                end
            end
        end

        for player in pairs(espObjects) do
            local info = infos[player]
            if info then
                local hrp = info.hrp
                local valid = hrp and hrp.Parent and resolveCharacter(player) == info.char
                local inRange = true
                if valid then
                    inRange = (camPos - hrp.Position).Magnitude <= cullDist
                end

                if inRange then
                    if heavy then
                        local ok = pcall(refreshPlayer, player, info, map)
                        if not ok then info.char = nil end
                    end
                    local hum = info.hum
                    if hum and info.hrp then
                        info.hp = hum.Health
                    end
                end
            end
        end

        if heavy then
            local tp = flags.totem and getTotemPosition() or nil
            if tp ~= totemPos then
                if tp and not totemPos then
                    if flags.totemNotify then
                        pcall(function()
                            notify("A totem ritual has been placed", "Totem Placement", 4)
                        end)
                    end
                end
                totemPos = tp
            end
            bonesPos = flags.bones and getBonesPosition() or nil
        end
    else
        totemPos = nil
        bonesPos = nil
    end

    if tickCount % 10 == 0 and tickCount >= 20 then
        local nowTaken, nowHolder = anyoneIsRegent()
        if not regentInit then
            regentInit = true
            regentCurrentlyTaken = nowTaken
        elseif nowTaken and not regentCurrentlyTaken then
            if flags.regentNotify and flags.enabled then
                pcall(function()
                    notify("Regent is taken" .. (nowHolder and (" by " .. nowHolder) or ""), "Regent", 4)
                end)
            end
            regentCurrentlyTaken = true
        elseif not nowTaken and regentCurrentlyTaken then
            if flags.regentNotify and flags.enabled then
                pcall(function()
                    notify("Regent is available", "Regent", 4)
                end)
            end
            regentCurrentlyTaken = false
        end
    end
end

task.spawn(function()
    while true do
        task.wait(0.1)
        pcall(slowTick)
    end
end)

local RENDER_INTERVAL = 1 / 60

local wasEnabled = false
local lastRender = 0
local frameCount = 0
local GRACE_FRAMES = 8

local function worldLabel(textObj, enabledFlag, pos, color, text, camPos)
    if enabledFlag and pos then
        local screenPos, onScreen = WorldToScreen(pos)
        if onScreen then
            local t = text
            if type(text) == "function" then t = text((camPos - pos).Magnitude) end
            set(textObj, "Color", color)
            set(textObj, "Text", t)
            setPos(textObj, screenPos.X, screenPos.Y)
            set(textObj, "Visible", true)
            return
        end
    end
    set(textObj, "Visible", false)
end

local function totemLabel(d)
    return "Totem (" .. math.floor(d) .. ")"
end

local function renderLoop()
    if not flags.enabled then
        if wasEnabled then
            wasEnabled = false
            for _, obj in pairs(espObjects) do hideAll(obj) end
            set(totemText, "Visible", false)
            set(bonesText, "Visible", false)
        end
        return
    end
    wasEnabled = true

    local now = clock()
    if now - lastRender < RENDER_INTERVAL * 0.9 then return end
    lastRender = now
    frameCount = frameCount + 1

    local cam = workspace.CurrentCamera
    if cam then Camera = cam end

    local cf = Camera.CFrame
    local camPos = cf.Position
    local look = useFrontCheck and cf.LookVector or nil
    local maxDist = flags.maxDist

    local fName, fHealth, fChar, fDist = flags.name, flags.health, flags.character, flags.distance
    local cName, cHealth = COLORS.name, COLORS.health
    local cRegent, cLinked, cBlade, cChan = COLORS.regent, COLORS.linked, COLORS.blade, COLORS.channel

    worldLabel(totemText, flags.totem, totemPos, COLORS.totem, totemLabel, camPos)
    worldLabel(bonesText, flags.bones, bonesPos, COLORS.bones, "Inadu Bones", camPos)

    for player, obj in pairs(espObjects) do
        local info = infos[player]
        local hrp = info and info.hrp
        local hp = info and info.hp

        local shown = false

        if hrp and hp and hp > 0 then
            local worldPos = hrp.Position
            local diff = worldPos - camPos
            local dist = diff.Magnitude

            if dist <= maxDist and (not look or diff:Dot(look) > 0) then
                local screenPos, onScreen = WorldToScreen(worldPos)
                if onScreen then
                    shown = true

                    local size = math.clamp(1500 / dist, 20, 250)
                    local x = screenPos.X
                    local y = screenPos.Y - size * 0.5 - 18

                    if info.regentText then
                        showLine(draw(obj, "regent"), info.regentText, cRegent, x, y)
                        y = y + 15
                    else
                        hideKey(obj, "regent")
                    end

                    if info.linkText then
                        local lc = (info.linkKind == "blade") and cBlade or cLinked
                        showLine(draw(obj, "linked"), info.linkText, lc, x, y)
                        y = y + 15
                    else
                        hideKey(obj, "linked")
                    end

                    if info.chText then
                        showLine(draw(obj, "channeling"), info.chText, cChan, x, y)
                        y = y + 15
                    else
                        hideKey(obj, "channeling")
                    end

                    if fChar and info.charName then
                        local nameColor = characterNameColor(info.species, info.charName, info.maxHp)
                        showLine(draw(obj, "character"), info.charName, nameColor, x, y)
                        y = y + 15
                    else
                        hideKey(obj, "character")
                    end

                    if fName then
                        showLine(draw(obj, "name"), player.Name, cName, x, y)
                        y = y + 16
                    else
                        hideKey(obj, "name")
                    end

                    if fHealth then
                        showLine(draw(obj, "health"),
                            "HP: " .. math.floor(hp) .. " / " .. (info.maxHp or 100),
                            cHealth, x, y)
                        y = y + 15
                    else
                        hideKey(obj, "health")
                    end

                    if fDist then
                        showLine(draw(obj, "dist"), tostring(math.floor(dist)), cName, x, y)
                    else
                        hideKey(obj, "dist")
                    end
                end
            end
        end

        if shown then
            info.lastShownFrame = frameCount
        else
            local lastShown = info.lastShownFrame
            if not lastShown or (frameCount - lastShown) > GRACE_FRAMES then
                hideAll(obj)
            end
        end
    end
end

local renderEntry = renderLoop
if PROFILE then
    local acc, n, last = 0, 0, clock()
    renderEntry = function()
        local t0 = clock()
        renderLoop()
        acc = acc + (clock() - t0)
        n = n + 1
        if clock() - last >= 5 then
            print(string.format("[Megs profile] avg render: %.3f ms over %d calls", (acc / n) * 1000, n))
            acc, n, last = 0, 0, clock()
        end
    end
end

local renderOK = pcall(function()
    RunService.RenderStepped:Connect(renderEntry)
end)
if not renderOK then
    task.spawn(function()
        while true do
            task.wait()
            pcall(renderEntry)
        end
    end)
end

