local function characterNameColor(species, charName, maxHp)
    if charName and CHARACTER_COLOR_OVERRIDES[charName] then
        return CHARACTER_COLOR_OVERRIDES[charName]
    end
    if charName and KNOWN_CHARACTERS[charName] then
        local sp = KNOWN_CHARACTERS[charName]
        if SPECIES_COLORS[sp] then return SPECIES_COLORS[sp] end
    end
    if species and SPECIES_COLORS[species] then
        return SPECIES_COLORS[species]
    end
    if maxHp and HP_TO_SPECIES[maxHp] then
        local sp = HP_TO_SPECIES[maxHp]
        if SPECIES_COLORS[sp] then return SPECIES_COLORS[sp] end
    end
    return SPECIES_FALLBACK
end

