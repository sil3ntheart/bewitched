-- ============================================================
-- Megs Script - Matcha version (v2, max-perf)
-- Order: Regency -> Linked -> Channeling -> Character -> Username -> HP -> Distance
-- Totem label: Totem (NN)
-- Config: saves/loads to megs_config.json (Color3-safe, no HttpService)
-- Notifications: Totem Placement, Regent Available, Regent Taken
--
-- Perf design:
--  * Drawing props only written when changed (write cache).
--  * Drawings created lazily (only when a line is first shown).
--  * Background loop @10 Hz: health + range checks.
--    Every 2nd tick (5 Hz): names, regent, links, channeling, totem, bones.
--  * Players beyond Max Distance are skipped in the background loop.
--  * Render loop: distance cull -> behind-camera cull -> WorldToScreen.
--  * Render rate is throttled (slider), default 60 Hz.
--  * Set PROFILE = true to print average render cost every 5s.
-- ============================================================

local PROFILE = false

local Nova = loadstring(httpget("https://raw.githubusercontent.com/Martinikaws/Nova/main/Nova.lua"))() or _G.Nova

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera
local clock = os.clock or tick

-- ============================================================
-- STATE
-- ============================================================
local flags = {
    enabled         = false,
    name            = true,
    character       = true,
    regent          = true,
    linked          = true,
    channeling      = true,
    totem           = true,
    totemNotify     = true,
    regentNotify    = true,
    bones           = true,
    health          = true,
    distance        = false,
    maxDist         = 2000,
    renderHz        = 60,
    nameColor       = Color3.fromRGB(255, 255, 255),
    charColor       = Color3.fromRGB(255, 200, 100),
    regentColor     = Color3.fromRGB(255, 215, 0),
    linkedColor     = Color3.fromRGB(100, 200, 255),
    bladeColor      = Color3.fromRGB(199, 125, 255),
    channelColor    = Color3.fromRGB(180, 255, 100),
    totemColor      = Color3.fromRGB(255, 100, 200),
    bonesColor      = Color3.fromRGB(230, 220, 200),
    healthColor     = Color3.fromRGB(120, 255, 120),
}

local espObjects = {}   -- [player] = { lazily created drawings }
local infos = {}        -- [player] = cached data
local totemPos = nil
local bonesPos = nil

-- ============================================================
-- CONFIG SAVE / LOAD
-- ============================================================
local CONFIG_FILE = "megs_config.json"

local function colorToStr(c)
    return string.format("%d,%d,%d",
        math.floor(c.R * 255 + 0.5),
        math.floor(c.G * 255 + 0.5),
        math.floor(c.B * 255 + 0.5))
end

local function strToColor(s)
    local r, g, b = s:match("^(%d+),(%d+),(%d+)$")
    if not r then return nil end
    return Color3.fromRGB(tonumber(r), tonumber(g), tonumber(b))
end

local function saveConfig()
    local lines = {}
    for k, v in pairs(flags) do
        if k == "enabled" then
            -- skip
        elseif typeof(v) == "Color3" then
            lines[#lines+1] = k .. "=C:" .. colorToStr(v)
        elseif type(v) == "boolean" then
            lines[#lines+1] = k .. "=B:" .. tostring(v)
        elseif type(v) == "number" then
            lines[#lines+1] = k .. "=N:" .. tostring(v)
        end
    end
    pcall(function()
        writefile(CONFIG_FILE, table.concat(lines, "\n"))
    end)
end

local function loadConfig()
    if not isfile(CONFIG_FILE) then return end
    local ok, raw = pcall(function() return readfile(CONFIG_FILE) end)
    if not ok or not raw or raw == "" then return end
    for line in raw:gmatch("[^\n]+") do
        local key, tag, val = line:match("^([^=]+)=([CBN]):(.+)$")
        if key and tag and val then
            if tag == "C" then
                local c = strToColor(val)
                if c then flags[key] = c end
            elseif tag == "B" then
                flags[key] = (val == "true")
            elseif tag == "N" then
                flags[key] = tonumber(val) or flags[key]
            end
        end
    end
end

loadConfig()

local savePending = false
local function scheduleSave()
    if savePending then return end
    savePending = true
    task.spawn(function()
        task.wait(0.4)
        savePending = false
        saveConfig()
    end)
end

local renderInterval = 1 / math.max(flags.renderHz, 1)

-- Feature-detect the cheap behind-camera test
local useFrontCheck = pcall(function()
    local v = Camera.CFrame.LookVector
    return Vector3.new(1, 0, 0):Dot(v)
end)

-- ============================================================
-- DRAWING HELPERS (write cache + lazy creation)
-- ============================================================
local cache = setmetatable({}, { __mode = "k" })

local function set(d, prop, val)
    local c = cache[d]
    if not c then
        c = {}
        cache[d] = c
    end
    if c[prop] ~= val then
        c[prop] = val
        d[prop] = val
    end
end

local function setPos(d, x, y)
    x = math.floor(x + 0.5)
    y = math.floor(y + 0.5)
    local c = cache[d]
    if not c then
        c = {}
        cache[d] = c
    end
    if c.px ~= x or c.py ~= y then
        c.px, c.py = x, y
        d.Position = Vector2.new(x, y)
    end
end

local function showLine(d, text, color, x, y)
    set(d, "Text", text)
    set(d, "Color", color)
    setPos(d, x, y)
    set(d, "Visible", true)
end

local function newText(size)
    local t = Drawing.new("Text")
    t.Size = size or 14
    t.Center = true
    t.Outline = true
    t.Visible = false
    return t
end

local SIZES = {
    name = 14, character = 13, regent = 13, linked = 13,
    channeling = 13, health = 13, dist = 12,
}

local function draw(obj, key)
    local d = obj[key]
    if not d then
        d = newText(SIZES[key])
        obj[key] = d
    end
    return d
end

local function hideKey(obj, key)
    local d = obj[key]
    if d then set(d, "Visible", false) end
end

local function hideAll(obj)
    for _, d in pairs(obj) do
        set(d, "Visible", false)
    end
end

local function removeAll(tbl)
    if not tbl then return end
    for _, d in pairs(tbl) do
        if d and d.Remove then pcall(function() d:Remove() end) end
    end
end

local function createESP(player)
    if player == LocalPlayer then return end
    if espObjects[player] then return end
    espObjects[player] = {}
    infos[player] = {}
end

local function removeESP(player)
    if not espObjects[player] then return end
    removeAll(espObjects[player])
    espObjects[player] = nil
    infos[player] = nil
end

pcall(function()
    for _, p in ipairs(Players:GetPlayers()) do createESP(p) end
end)
pcall(function()
    if Players.PlayerAdded then Players.PlayerAdded:Connect(createESP) end
end)
pcall(function()
    if Players.PlayerRemoving then Players.PlayerRemoving:Connect(removeESP) end
end)

local function syncPlayers()
    local ok, list = pcall(function() return Players:GetPlayers() end)
    if not (ok and list) then return end
    local seen = {}
    for _, p in ipairs(list) do
        seen[p] = true
        if not espObjects[p] and p ~= LocalPlayer then
            createESP(p)
        end
    end
    for p in pairs(espObjects) do
        if not seen[p] then removeESP(p) end
    end
end

local totemText = newText(16)
local bonesText = newText(16)

-- ============================================================
-- READERS (background loop only)
-- ============================================================
local function playerFromCharacter(model, map)
    if not model then return nil end
    local p = map[model]
    if p then return p end
    for _, pl in ipairs(Players:GetPlayers()) do
        local c = pl.Character
        if c and model:IsDescendantOf(c) then return pl end
    end
    return nil
end

local function readString(obj)
    if obj:FindFirstChild("StringValue") or obj:IsA("StringValue") then
        local ok, v = pcall(function() return obj.Value end)
        if ok and v and v ~= "" then return tostring(v) end
    end
    return nil
end

local function getCharacterNameFast(character)
    local head = character:FindFirstChild("Head")
    if head then
        local info = head:FindFirstChild("Info")
        if info then
            local label = info:FindFirstChild("CharacterName")
            if label then
                local tl = label:FindFirstChild("TextLabel")
                if tl and tl.Text and tl.Text ~= "" then
                    return tostring(tl.Text)
                end
                if label:IsA("TextLabel") and label.Text and label.Text ~= "" then
                    return tostring(label.Text)
                end
            end
        end
    end
    return nil
end

local function getCharacterNameSlow(character)
    for _, d in ipairs(character:GetDescendants()) do
        if d.Name == "CharacterName" then
            local tl = d:FindFirstChildWhichIsA("TextLabel")
            if tl and tl.Text and tl.Text ~= "" then
                return tostring(tl.Text)
            end
            if d:IsA("TextLabel") and d.Text and d.Text ~= "" then
                return tostring(d.Text)
            end
        end
    end
    return nil
end

local function getLinkInfo(cv, map)
    local sac = cv:FindFirstChild("SacrificeLink")
    if sac then
        local ok, val = pcall(function() return sac.Value end)
        if ok and val then
            local partner = playerFromCharacter(val, map)
            return partner and partner.Name or val.Name, "blade"
        end
    end

    local conn = cv:FindFirstChild("ConnectiveMagic")
    if conn then
        local ok, val = pcall(function() return conn.Value end)
        if ok and val then
            local partner = playerFromCharacter(val, map)
            if partner then return partner.Name, "linked" end
        end
    end

    return nil, nil
end

-- ============================================================
-- WORLD OBJECTS
-- ============================================================
local function getTotemPosition()
    local gameFolder = workspace:FindFirstChild("Game")
    if not gameFolder then return nil end

    local debris = gameFolder:FindFirstChild("Debris")
    if debris then
        local totemModel = debris:FindFirstChild("Totem")
        if totemModel then
            local mesh = totemModel:FindFirstChild("Totem")
            if mesh and mesh:IsA("BasePart") then
                return mesh.Position
            end
            if totemModel:IsA("Model") and totemModel.PrimaryPart then
                return totemModel.PrimaryPart.Position
            end
            for _, part in ipairs(totemModel:GetDescendants()) do
                if part:IsA("BasePart") and part.Transparency < 1 then
                    local n = part.Name
                    if n ~= "Swirls" and n ~= "Swirls2" and n ~= "Boundary" then
                        return part.Position
                    end
                end
            end
        end
    end

    local rituals = gameFolder:FindFirstChild("Rituals")
    if rituals then
        local totemModel = rituals:FindFirstChild("Totem")
        if totemModel then
            local mesh = totemModel:FindFirstChild("Totem")
            if mesh and mesh:IsA("BasePart") then
                return mesh.Position
            end
        end
    end

    return nil
end

local function isTotemPlaced()
    local gameFolder = workspace:FindFirstChild("Game")
    if not gameFolder then return false end

    local debris = gameFolder:FindFirstChild("Debris")
    if debris and debris:FindFirstChild("Totem") then return true end

    local rituals = gameFolder:FindFirstChild("Rituals")
    if rituals and rituals:FindFirstChild("Totem") then return true end

    return false
end

local function getBonesPosition()
    local gameFolder = workspace:FindFirstChild("Game")
    if not gameFolder then return nil end
    local debris = gameFolder:FindFirstChild("Debris")
    if not debris then return nil end
    local bones = debris:FindFirstChild("Bones")
    if not bones then return nil end

    local main = bones:FindFirstChild("Main")
    if main and main:IsA("BasePart") and main.Transparency < 1 then
        return main.Position
    end
    for _, part in ipairs(bones:GetChildren()) do
        if part:IsA("BasePart") and part.Transparency < 1 then
            return part.Position
        end
    end
    return nil
end

local function anyoneIsRegent()
    for _, p in ipairs(Players:GetPlayers()) do
        local char = p.Character
        if char then
            local cv = char:FindFirstChild("CharacterValues")
            if cv and cv:FindFirstChild("Regent") then
                return true, p.Name
            end
        end
    end
    return false, nil
end

-- ============================================================
-- BACKGROUND LOOP (10 Hz; heavy work every 2nd tick = 5 Hz)
-- ============================================================
local tickCount = 0
local totemWasPlaced = isTotemPlaced()
local regentCurrentlyTaken = false
local regentInit = false

local function refreshPlayer(player, info, map)
    local char = player.Character

    if char ~= info.char then
        info.char = char
        info.hrp = nil
        info.hum = nil
        info.hp = nil
        info.regentText = nil
        info.linkText = nil
        info.linkKind = nil
        info.chText = nil
        info.charName = nil
        info.nameFallbackTick = nil
    end
    if not char then return end

    if not info.hrp or not info.hrp.Parent then
        info.hrp = char:FindFirstChild("HumanoidRootPart")
    end
    if not info.hum or not info.hum.Parent then
        info.hum = char:FindFirstChildOfClass("Humanoid")
    end
    if info.hum then
        info.maxHp = math.floor(info.hum.MaxHealth)
    end

    local cv = char:FindFirstChild("CharacterValues")

    info.regentText = nil
    if flags.regent and cv then
        local r = cv:FindFirstChild("Regent")
        if r then
            local rv = readString(r)
            info.regentText = rv and ("Regent: " .. rv) or "Regent"
        end
    end

    info.linkText, info.linkKind = nil, nil
    if flags.linked and cv then
        local name, kind = getLinkInfo(cv, map)
        if name then
            info.linkKind = kind
            info.linkText = (kind == "blade" and "Blade Linked: " or "Linked: ") .. name
        end
    end

    info.chText = nil
    if flags.channeling and cv then
        local ch = cv:FindFirstChild("Channeled")
        if ch then
            local t = readString(ch)
            if t then info.chText = "Channeling: " .. t end
        end
    end

    if flags.character then
        local n = getCharacterNameFast(char)
        if n then
            info.charName = n
        elseif not info.charName then
            -- rare, throttled fallback (~every 5s)
            if not info.nameFallbackTick or (tickCount - info.nameFallbackTick) >= 50 then
                info.nameFallbackTick = tickCount
                info.charName = getCharacterNameSlow(char)
            end
        end
    else
        info.charName = nil
    end
end

local function slowTick()
    tickCount = tickCount + 1
    local heavy = (tickCount % 2 == 0)

    local cam = workspace.CurrentCamera
    if cam then Camera = cam end

    if tickCount % 10 == 0 then
        syncPlayers()
    end

    if flags.enabled then
        local camPos = Camera.CFrame.Position
        local cullDist = flags.maxDist * 1.1

        local map
        if heavy then
            map = {}
            for _, p in ipairs(Players:GetPlayers()) do
                local c = p.Character
                if c then map[c] = p end
            end
        end

        for player in pairs(espObjects) do
            local info = infos[player]
            if info then
                local hrp = info.hrp
                local valid = hrp and hrp.Parent and player.Character == info.char
                local inRange = true
                if valid then
                    inRange = (camPos - hrp.Position).Magnitude <= cullDist
                end

                -- skip everything for far-away players
                if inRange then
                    if heavy or not valid then
                        if heavy then
                            local ok = pcall(refreshPlayer, player, info, map)
                            if not ok then info.char = nil end
                        end
                    end
                    local hum = info.hum
                    if hum and info.hrp then
                        info.hp = hum.Health
                    end
                end
            end
        end

        if heavy then
            totemPos = flags.totem and getTotemPosition() or nil
            bonesPos = flags.bones and getBonesPosition() or nil
        end
    else
        totemPos = nil
        bonesPos = nil
    end

    -- Totem placement notification (~0.4s)
    if tickCount % 4 == 0 then
        local nowPlaced = isTotemPlaced()
        if nowPlaced and not totemWasPlaced then
            if flags.totemNotify and flags.enabled then
                pcall(function()
                    notify("A totem ritual has been placed", "Totem Placement", 4)
                end)
            end
            totemWasPlaced = true
        elseif not nowPlaced and totemWasPlaced then
            totemWasPlaced = false
        end
    end

    -- Regent notification (~1s, first state captured after ~2s)
    if tickCount % 10 == 0 and tickCount >= 20 then
        local nowTaken, nowHolder = anyoneIsRegent()
        if not regentInit then
            regentInit = true
            regentCurrentlyTaken = nowTaken
            print("[Regent] initial state: " .. (nowTaken and ("taken by " .. tostring(nowHolder)) or "available"))
        elseif nowTaken and not regentCurrentlyTaken then
            if flags.regentNotify and flags.enabled then
                pcall(function()
                    notify("Regent is taken" .. (nowHolder and (" by " .. nowHolder) or ""), "Regent", 4)
                end)
            end
            regentCurrentlyTaken = true
        elseif not nowTaken and regentCurrentlyTaken then
            if flags.regentNotify and flags.enabled then
                pcall(function()
                    notify("Regent is available", "Regent", 4)
                end)
            end
            regentCurrentlyTaken = false
        end
    end
end

task.spawn(function()
    while true do
        task.wait(0.1)
        pcall(slowTick)
    end
end)

-- ============================================================
-- RENDER LOOP (throttled; reads only position per player)
-- ============================================================
local wasEnabled = false
local lastRender = 0

local function worldLabel(textObj, enabledFlag, pos, color, text, camPos)
    if enabledFlag and pos then
        local screenPos, onScreen = WorldToScreen(pos)
        if onScreen then
            local t = text
            if type(text) == "function" then t = text((camPos - pos).Magnitude) end
            set(textObj, "Color", color)
            set(textObj, "Text", t)
            setPos(textObj, screenPos.X, screenPos.Y)
            set(textObj, "Visible", true)
            return
        end
    end
    set(textObj, "Visible", false)
end

local function totemLabel(d)
    return "Totem (" .. math.floor(d) .. ")"
end

local function renderLoop()
    if not flags.enabled then
        if wasEnabled then
            wasEnabled = false
            for _, obj in pairs(espObjects) do hideAll(obj) end
            set(totemText, "Visible", false)
            set(bonesText, "Visible", false)
        end
        return
    end
    wasEnabled = true

    -- throttle (0.9 tolerance so a matching refresh rate doesn't halve)
    local now = clock()
    if now - lastRender < renderInterval * 0.9 then return end
    lastRender = now

    local cf = Camera.CFrame
    local camPos = cf.Position
    local look = useFrontCheck and cf.LookVector or nil
    local maxDist = flags.maxDist

    -- cache flags into locals
    local fName, fHealth, fChar, fDist = flags.name, flags.health, flags.character, flags.distance
    local cName, cHealth, cChar = flags.nameColor, flags.healthColor, flags.charColor
    local cRegent, cLinked, cBlade, cChan = flags.regentColor, flags.linkedColor, flags.bladeColor, flags.channelColor

    worldLabel(totemText, flags.totem, totemPos, flags.totemColor, totemLabel, camPos)
    worldLabel(bonesText, flags.bones, bonesPos, flags.bonesColor, "Inadu Bones", camPos)

    for player, obj in pairs(espObjects) do
        local info = infos[player]
        local hrp = info and info.hrp
        local hp = info and info.hp

        local shown = false

        if hrp and hp and hp > 0 then
            local worldPos = hrp.Position
            local diff = worldPos - camPos
            local dist = diff.Magnitude

            -- 1) distance cull, 2) behind-camera cull, 3) projection
            if dist <= maxDist and (not look or diff:Dot(look) > 0) then
                local screenPos, onScreen = WorldToScreen(worldPos)
                if onScreen then
                    shown = true

                    local size = math.clamp(1500 / dist, 20, 250)
                    local x = screenPos.X
                    local y = screenPos.Y - size * 0.5 - 18

                    if info.regentText then
                        showLine(draw(obj, "regent"), info.regentText, cRegent, x, y)
                        y = y + 15
                    else
                        hideKey(obj, "regent")
                    end

                    if info.linkText then
                        showLine(draw(obj, "linked"), info.linkText,
                            (info.linkKind == "blade") and cBlade or cLinked, x, y)
                        y = y + 15
                    else
                        hideKey(obj, "linked")
                    end

                    if info.chText then
                        showLine(draw(obj, "channeling"), info.chText, cChan, x, y)
                        y = y + 15
                    else
                        hideKey(obj, "channeling")
                    end

                    if fChar and info.charName then
                        showLine(draw(obj, "character"), info.charName, cChar, x, y)
                        y = y + 15
                    else
                        hideKey(obj, "character")
                    end

                    if fName then
                        showLine(draw(obj, "name"), player.Name, cName, x, y)
                        y = y + 16
                    else
                        hideKey(obj, "name")
                    end

                    if fHealth then
                        showLine(draw(obj, "health"),
                            "HP: " .. math.floor(hp) .. " / " .. (info.maxHp or 100),
                            cHealth, x, y)
                        y = y + 15
                    else
                        hideKey(obj, "health")
                    end

                    if fDist then
                        showLine(draw(obj, "dist"), tostring(math.floor(dist)), cName, x, y)
                    else
                        hideKey(obj, "dist")
                    end
                end
            end
        end

        if not shown then
            hideAll(obj)
        end
    end
end

-- optional profiler
local renderEntry = renderLoop
if PROFILE then
    local acc, n, last = 0, 0, clock()
    renderEntry = function()
        local t0 = clock()
        renderLoop()
        acc = acc + (clock() - t0)
        n = n + 1
        if clock() - last >= 5 then
            print(string.format("[Megs profile] avg render: %.3f ms over %d calls", (acc / n) * 1000, n))
            acc, n, last = 0, 0, clock()
        end
    end
end

local renderOK = pcall(function()
    RunService.RenderStepped:Connect(renderEntry)
end)
if not renderOK then
    task.spawn(function()
        while true do
            task.wait()
            pcall(renderEntry)
        end
    end)
end

